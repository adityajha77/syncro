// Prisma schema for Syncro (Connected Workspace)
//
// Core model:
//   User ──< WorkspaceMember >── Workspace
//   Workspace ──< Task | CalendarEvent | Commit | ActivityRecord
//
// ActivityRecord is the "Universal Activity Ledger": every mutation anywhere in
// the workspace (task change, commit, event, member join...) appends one row.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EventCategory {
  STANDUP
  REVIEW
  DEADLINE
  SYNC
}

enum ActivityType {
  WORKSPACE_CREATED
  MEMBER_JOINED
  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_COMPLETED
  TASK_DELETED
  COMMIT_PUSHED
  EVENT_SCHEDULED
  EVENT_DELETED
  REPO_CONNECTED
  MEMBER_LEFT
  COMMITS_SYNCED
}

enum IntegrationProvider {
  GITHUB
  GOOGLE
}

enum CommitSource {
  MANUAL
  GITHUB
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   WorkspaceMember[]
  assignedTasks Task[]            @relation("TaskAssignee")
  createdTasks  Task[]            @relation("TaskCreator")
  commits       Commit[]
  events        CalendarEvent[]
  activities    ActivityRecord[]
  integrations  Integration[]

  @@map("users")
}

model Workspace {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  repoFullName   String? // e.g. "org/repo"
  defaultBranch  String    @default("main")
  inviteCode     String?   @unique // share to let others join; null = backfilled lazily
  githubSyncedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members    WorkspaceMember[]
  tasks      Task[]
  commits    Commit[]
  events     CalendarEvent[]
  activities ActivityRecord[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  role        Role      @default(MEMBER)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  label       String? // free-form project/area label shown on the board
  completedAt DateTime?
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workspaceId, status])
  @@map("tasks")
}

model Commit {
  id          String       @id @default(uuid())
  sha         String
  message     String
  branch      String
  source      CommitSource @default(MANUAL)
  url         String?
  authorName  String       @default("Unknown") // display name (GitHub author or Syncro user)
  authorLogin String? // GitHub login when known
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String? // Syncro user, when the author is a member
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  committedAt DateTime     @default(now())

  @@unique([workspaceId, sha])
  @@index([workspaceId, committedAt])
  @@map("commits")
}

model CalendarEvent {
  id            String        @id @default(uuid())
  title         String
  startsAt      DateTime
  category      EventCategory @default(SYNC)
  location      String?
  googleEventId String? // set when mirrored to the creator's Google Calendar
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@index([workspaceId, startsAt])
  @@map("calendar_events")
}

model ActivityRecord {
  id          String       @id @default(uuid())
  type        ActivityType
  summary     String
  entityType  String? // "task" | "commit" | "event" | "workspace" | "member"
  entityId    String?
  metadata    Json?
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User         @relation(fields: [actorId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@index([workspaceId, createdAt])
  @@map("activity_records")
}

/// OAuth connection from a user to an external provider. Tokens are AES-256-GCM encrypted.
model Integration {
  id                 String              @id @default(uuid())
  provider           IntegrationProvider
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId          String // provider's user id
  accountLabel       String // GitHub login / Google email, for display
  scopes             String
  accessTokenEnc     String
  refreshTokenEnc    String?
  accessTokenExpires DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([userId, provider])
  @@map("integrations")
}
