PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/syncro?schema=public"
CLIENT_ORIGIN="http://localhost:5173"
JWT_SECRET="change-me-to-a-long-random-string"
# Optional: CA cert for verified TLS to hosted Postgres (e.g. Supabase prod-ca-2021.crt)
# DATABASE_SSL_CA="./certs/supabase-ca.crt"

# Public URL of this API (OAuth callbacks are built from it)
API_PUBLIC_URL="http://localhost:5000"
# 32 random bytes, base64 — encrypts OAuth tokens at rest. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# GitHub OAuth App — callback: http://localhost:5000/api/v1/integrations/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth client (Web) — redirect URI: http://localhost:5000/api/v1/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
